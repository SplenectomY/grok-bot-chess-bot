  "knobDocs": {
    "GUARD_MATE_N": "guard re-draws a move that allows mate-in-<=N (prob GUARD_MATE1_P) when the best move doesn't; 1 = old behaviour",
    "GUARD_MAT_ON": ">=0.5 enables the eval-clamp-independent material rule: candidate is a hang if its SEE net or 5-ply PV material is >=3 pawns worse than the top move's and the raw (unclamped, mate=3000) eval drop is >=40cp in decided positions (|raw top| >= 300cp) or >=100cp otherwise (worker constants GUARD_MAT_LOSS/GUARD_MAT_MIN_DROP/GUARD_MAT_DECIDED/GUARD_MAT_MIN_DROP_OPEN)",
    "BUDGET_ON": ">=0.5 enables the per-game blunder budget",
    "B1_*": "after 1 bot blunder on the board this game: guard probs raised to at least B1_OBV/B1_SUB/B1_QUEEN/B1_MATE/B1_WC; P_BLIND multiplied by B1_BLIND",
    "B2_*": "after 2+ blunders: same with B2_*",
    "GUARD_WC_P": "probability the guard re-draws a non-material Lichess-scale blunder (deep win-chance drop >= 15 points vs the top move) that no hang/mate/queen test flagged; 0 = off",
    "budget": "a bot move counts toward the budget when it reaches the board flagged (guard kept it) or loses >= 15 win% (deep view). Pairs (position, SAN) are persisted per gameId (loop sends room:gameNumber) under CHESS_BUDGET_DIR or <worker dir>/.budget, so worker/loop restarts keep the count"
  }
